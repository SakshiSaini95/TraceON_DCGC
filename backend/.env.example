PORT=5000

# Generate each key locally; keep them server-side and out of source control.
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TRACEON_PII_ENCRYPTION_KEY=
TRACEON_EVIDENCE_ADMIN_KEY=

