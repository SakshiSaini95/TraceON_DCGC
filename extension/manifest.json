{
  "manifest_version": 3,
  "name": "TRACEON - Seller Safety Checker",
  "version": "1.0.0",
  "description": "Check seller profiles using TRACEON risk analysis.",
  "permissions": ["activeTab", "storage"],
  "host_permissions": [
    "http://localhost:5000/*",
    "https://www.instagram.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "TRACEON Seller Checker"
  },
  "content_scripts": [
    {
      "matches": ["https://www.instagram.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}

